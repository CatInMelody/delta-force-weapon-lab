[node name="Description" type="Label" parent="Surface/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.61, 0.67, 0.83, 1)
text = "更新枪械、弹药与防具数据，无需重新下载完整程序。\n安装后重新加载生效，个人方案与标题会保留。"
